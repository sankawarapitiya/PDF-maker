<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: cleartext (http://) traffic is refused for every host, and only
     system-installed certificate authorities are trusted (user-added CAs, often
     used for interception, are ignored). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
