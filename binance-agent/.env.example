# Copy to .env — never commit real keys.
# Create keys with "Enable Spot & Margin Trading" ONLY. NEVER enable withdrawals.
# Restrict the key to your IP address in Binance API management.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet keys: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Must be set to YES to allow mode: live
CONFIRM_LIVE_TRADING=NO
